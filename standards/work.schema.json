{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "locator_version",
    "title",
    "canonical_structure"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "locator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "canonical_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_section_id",
              "parent_id",
              "order",
              "title",
              "units"
            ],
            "properties": {
              "canonical_section_id": {
                "type": "string",
                "pattern": "\\S"
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "canonical_unit_id",
                    "order",
                    "role"
                  ],
                  "properties": {
                    "canonical_unit_id": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "role": {
                      "const": "classic_text"
                    },
                    "segments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "canonical_segment_id",
                          "order"
                        ],
                        "properties": {
                          "canonical_segment_id": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "order": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
